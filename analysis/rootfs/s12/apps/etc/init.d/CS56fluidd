if [ "$(id -u)" -eq 0 ]; then
      su -c "$0 $@" creality
      exit 0
fi

PROG="nexusp"
#PROG="moonraker"
START_SERVER_PATH=/usr/apps/etc/init.d/fluidd

start() {
    if [ ${PROG} == "moonraker" ]; then
        ${START_SERVER_PATH}/CS56moonraker_service start
    else
        ${START_SERVER_PATH}/CS56nexusp_service start
    fi
}
stop() {
    if [ ${PROG} == "moonraker" ]; then
        ${START_SERVER_PATH}/CS56moonraker_service stop
    else
        ${START_SERVER_PATH}/CS56nexusp_service stop
    fi
}
restart() {
        stop
        sleep 2
        start
}

case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        restart
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?