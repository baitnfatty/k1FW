#!/bin/sh
# moonraker-db-shim — implements the database methods nexusp lacks.
# Lives on /usr/apps (p8, persistent). Runs BEFORE S98fluidd so nginx has
# its upstream ready. /tmp and /var are RAM initramfs; nothing may live there.
PY=/usr/share/klippy-env/bin/python3
APP=/usr/data/wsshim/moonraker-db-shim.py
PIDF=/usr/data/wsshim/shim.pid

start() {
    [ -f "$APP" ] || { echo "db-shim: $APP missing"; return 1; }
    if [ -f "$PIDF" ] && kill -0 "$(cat $PIDF)" 2>/dev/null; then
        echo "db-shim: already running"; return 0
    fi
    mkdir -p /usr/data/wsshim /usr/data/db_backups
    printf "Starting moonraker-db-shim (:4409): "
    setsid "$PY" "$APP" </dev/null >/usr/data/wsshim/stdout.log 2>&1 &
    echo $! > "$PIDF"
    # Confirm it actually BOUND the port - a live process that failed to
    # bind (e.g. a stale instance still holding :4409) is not success.
    i=0
    while [ $i -lt 10 ]; do
        if (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep -q ":4409 "; then
            echo "OK"; return 0
        fi
        i=$((i+1)); sleep 1
    done
    echo "FAIL (not listening on 4409 - see /usr/data/wsshim/stdout.log)"
    return 1
}
stop() {
    printf "Stopping moonraker-db-shim: "
    killed=""
    # 1) the tracked pid
    if [ -f "$PIDF" ]; then
        p=$(cat "$PIDF" 2>/dev/null)
        [ -n "$p" ] && kill "$p" 2>/dev/null && killed="$killed $p"
        rm -f "$PIDF"
    fi
    # 2) ALWAYS sweep for strays too - an untracked instance squatting on
    #    :4409 makes every later start() silently fail to bind.
    #    busybox has no pkill, so walk /proc.
    for d in /proc/[0-9]*; do
        pid=${d#/proc/}
        grep -qa moonraker-db-shim "$d/cmdline" 2>/dev/null || continue
        case " $killed " in *" $pid "*) continue ;; esac
        kill "$pid" 2>/dev/null && killed="$killed $pid"
    done
    sleep 1
    # 3) escalate to KILL for anything that ignored SIGTERM
    for pid in $killed; do
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    done
    if [ -n "$killed" ]; then echo "OK (${killed# })"; else echo "not running"; fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; sleep 1; start ;;
    status)
        if [ -f "$PIDF" ] && kill -0 "$(cat $PIDF)" 2>/dev/null
        then echo "running (pid $(cat $PIDF))"; else echo "stopped"; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
